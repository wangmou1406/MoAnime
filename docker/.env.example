# ============================================================
#  动漫下载机 · docker compose 环境变量示例
#
#  用法：把这个文件复制成 .env（同目录），按需修改即可。
#        docker compose 会自动读取同目录的 .env，
#        不需要再改 docker-compose.yml。
#
#     copy .env.example .env      # Windows
#     cp .env.example .env        # Linux / NAS
# ============================================================

# ---------------------------------------------------------- 路径（最常改的）
# 宿主机上放「视频与字幕」的目录。
#   * 相对路径相对 compose 文件所在目录，例如 ./downloads
#   * 也可以写绝对路径：
#       Windows   D:/Anime
#       NAS       /volume1/video/anime
#       Linux     /mnt/data/anime
#   * 建议放在容量大的盘上；Windows 的 UNC 路径（\\NAS\share\anime）
#     需要 Docker Desktop 先做好网络盘映射，否则挂载会失败。
AD_DOWNLOAD_HOST=./downloads

# 宿主机上放「数据库 / 设置 / 日志 / 缩略图缓存」的目录。
# 不挂出来的话，容器重建后配置就丢了。
AD_DATA_HOST=./docker-data

# 容器内的下载目录。一般不用改；只有当你想让容器内部也用别的路径
# （例如和别的服务保持一致的 /media/anime）时才动。
AD_IN_DOWNLOAD=/downloads

# ---------------------------------------------------------- 端口
# 宿主机映射端口。8848 被占用时改成别的（例如 18848）。
AD_HOST_PORT=8848

# ---------------------------------------------------------- 下载行为
# 同时下载的剧集数
AD_CONCURRENT_TASKS=3
# 单个任务的分片并发
AD_SEGMENT_THREADS=8
# 日志级别：DEBUG / INFO / WARNING / ERROR
AD_LOG_LEVEL=INFO
# 界面主题：light / dark
AD_THEME=light
