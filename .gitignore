# ============================================================================
#  动漫下载机 .gitignore
#
#  目录布局：
#      source/   代码根（core web sources static templates tools run.py）
#      python/   运行根（.venv data logs downloads）+ 便携版产物
#      docker/   Docker 版（Dockerfile / compose / docker-data / dist）
#      desktop/  桌面版（宿主工程 / spec / nsis / dist）
# ============================================================================

# ---------------------------------------------------------------- 通用
__pycache__/
*.py[cod]
*.pyc
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 代码根
# 外部二进制太大且需按平台取，不进版本库
source/tools/ffmpeg.exe
source/tools/ffmpeg
source/tools/*.exe
source/tools/*.dll

# 代码根下如果被误生成运行数据（例如手动跑 run.py 没设环境变量），也不入库
source/data/
source/logs/
source/downloads/

# ---------------------------------------------------------------- Python 版运行根
python/.venv/
python/downloads/*
!python/downloads/.gitkeep
python/logs/
python/data/*
# 内核（约 540 MB）与运行期缓存
!python/data/.gitkeep

# 构建中间产物
python/data/_*
# 注意：不能用 `python/dist/` 这种「忽略整个目录」的写法，
# 否则下面再想用 !python/dist/README.md 把说明放回来是**无效**的
# （git 规定：父目录被排除后，里面的文件无法再单独 include）。
python/dist/*
!python/dist/README.md

# ---------------------------------------------------------------- Docker 版
docker/docker-data/
docker/downloads/
docker/dist/*
!docker/dist/README.md
# 本机 compose 变量（含你自己的磁盘路径）；模板是 .env.example
docker/.env

# ---------------------------------------------------------------- 桌面版
desktop/dist/*
!desktop/dist/README.md
desktop/webview2-host/bin/
desktop/webview2-host/obj/
desktop/webview2-host/publish/

# ---------------------------------------------------------------- 三份交付说明要进仓库
# 上面按目录忽略了 dist/，这里把每个版本目录下的说明文件放回来
!docker/dist/README.md
!python/dist/README.md
!desktop/dist/README.md

# ---------------------------------------------------------------- 其它
# 广告检测中断留下的临时目录
addetect_*/
