# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
.tmp/
*.pyc

# ---------------------------------------------------------------- 运行期数据
# 数据库（含 WAL/SHM）、设置
data/*.db
data/*.db-wal
data/*.db-shm
data/settings.json

# 运行期生成的图片 / 缓存目录
data/*.png
data/backgrounds/
data/thumbs/
data/.sniffer-tmp/

# **内置浏览器内核与 Node**（约 540 MB，绝不进版本库）
# 本地版由 tools/fetch_* 或手动放置；Docker 版在镜像构建时下载到 /opt/pwt
data/_pwt/

# 临时抽帧 / 广告检测中断留下的目录（前缀固定，方便识别）
data/_frames/
addetect_*/

# 日志与下载
logs/*.log*
downloads/*
!downloads/.gitkeep

# ---------------------------------------------------------------- 外部二进制
# 各平台可执行文件太大且需按平台取，统一不进版本库
tools/ffmpeg.exe
tools/ffmpeg/
tools/*.exe
tools/*.dll

# ---------------------------------------------------------------- Docker
docker-data/
# 本机的 compose 变量（含你自己的磁盘路径），不要提交；模板是 .env.example
.env
dist/
anime-downloader-*.tar
anime-downloader-*.tar.sha256

data/browser-profile/

data/logs/

# .NET 构建产物
desktop/webview2-host/bin/
desktop/webview2-host/obj/
desktop/webview2-host/publish/
data/webview2/
# dist\ 既装产物也装三份说明；说明要进仓库，产物不进
!dist/**/README.md
data/_pyi/
data/_setup.*
data/_build_*.log
desktop/webview2-host/publish/

# data/ 下所有以 _ 开头的一律是构建/运行临时产物（_pwt 内核、_pyi 工作目录、_xxx.log 等）
data/_*
